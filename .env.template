# Enterprise OSINT Platform — Environment Variables
# Copy to .env and fill in real values. Never commit .env to version control.
#
# Quick start:
#   cp .env.template .env
#   # Edit .env with your values
#   docker compose up -d

# ── Core Infrastructure Secrets (required) ────────────────────────────────────
# JWT signing key — use a random 32+ character string in production
JWT_SECRET_KEY=change-me-to-a-random-32-char-minimum-string

# PostgreSQL password — used by both the DB and the backend
POSTGRES_PASSWORD=change-me-in-production

# ── Password Vault (daringanitch/password-vault) ─────────────────────────────
# One-time setup — run these commands ONCE after first clone:
#
#   1. Generate master key (prints VAULT_MASTER_KEY — save it):
#        docker compose run --rm vault-cli init
#
#   2. Start the vault:
#        export VAULT_MASTER_KEY=<key-from-step-1>
#        echo "VAULT_MASTER_KEY=<key>" >> .env
#        docker compose up password-vault -d
#
#   3. Add API keys (repeat for each key you have):
#        docker compose run --rm vault-cli secret add --key openai_api_key     --value sk-...
#        docker compose run --rm vault-cli secret add --key shodan_api_key     --value ...
#        docker compose run --rm vault-cli secret add --key virustotal_api_key --value ...
#        docker compose run --rm vault-cli secret add --key abuseipdb_api_key  --value ...
#        docker compose run --rm vault-cli secret add --key twitter_bearer_token --value ...
#        docker compose run --rm vault-cli secret add --key reddit_api_key     --value ...
#        docker compose run --rm vault-cli secret add --key hibp_api_key       --value ...
#        docker compose run --rm vault-cli secret add --key dehashed_api_key   --value ...
#
#   4. Create a backend access token (prints token — save it):
#        docker compose run --rm vault-cli token create --name osint-backend
#        echo "VAULT_TOKEN=<token>" >> .env
#
#   5. Start everything:
#        docker compose up -d

# Master key for the vault process itself (generated by vault-cli init)
VAULT_MASTER_KEY=

# Access token for the backend to read secrets from the vault (generated by vault-cli token create)
VAULT_TOKEN=

# ── API Keys (optional — stored in vault after setup above) ──────────────────
# You can EITHER add these to the vault (recommended) OR set them here as env vars.
# If both are set, the environment variable takes precedence over the vault.
OPENAI_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
TWITTER_BEARER_TOKEN=
REDDIT_API_KEY=
ALIENVAULT_OTX_API_KEY=
HIBP_API_KEY=
DEHASHED_API_KEY=
GITHUB_TOKEN=

# ── MCP Server URLs ────────────────────────────────────────────────────────────
MCP_INFRASTRUCTURE_URL=http://mcp-infrastructure-enhanced:8021
MCP_SOCIAL_URL=http://mcp-social-enhanced:8010
MCP_THREAT_URL=http://mcp-threat-enhanced:8020
MCP_FINANCIAL_URL=http://mcp-financial-enhanced:8040
MCP_TECHNICAL_URL=http://mcp-technical-enhanced:8050

# ── Network / CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:8080,http://your-domain.com:8080

# ── Compliance ─────────────────────────────────────────────────────────────────
ADMIN_CONTACT_EMAIL=admin@your-organization.com
DATA_RETENTION_DAYS=30

# ── Development Flags ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
